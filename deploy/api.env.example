APP_NAME=Pocket Farm API
DEBUG=false
API_V1_PREFIX=/api/v1

# When Compose also runs MySQL, keep these credentials identical to mysql.env and
# use mysql as the host. For an external database, replace the full connection URL.
# URL-encode reserved characters in the username and password.
DATABASE_URL=mysql+aiomysql://pocket_farm:replace-with-a-random-hex-password@mysql:3306/pocket_farm?charset=utf8mb4

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
APP_TIMEZONE=Asia/Shanghai

# Production default. Enable only for a short, access-controlled test and set a non-default code.
TEST_LOGIN_ENABLED=false
TEST_LOGIN_CODE=

# Leave both values empty only when AI testing is not needed.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_DAILY_TURN_LIMIT=20
# Comma-separated phone numbers exempt from the daily AI request limit.
AI_UNLIMITED_PHONE_NUMBERS=
AI_MAX_MESSAGE_CHARS=1000
AI_MAX_HISTORY_TURNS=8
AI_MAX_TOOL_CALLS_PER_TURN=6
AI_MAX_OUTPUT_TOKENS=800
AI_NOTICE_VERSION=v1
AI_USER_ID_HASH_KEY=
