{
  "name": "pocket-farm",
  "version": "1.0.0",
  "description": "Pocket Farm monorepo",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "api:dev": "uv run --directory apps/api uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "miniapp:dev": "pnpm --filter uni-preset-vue dev:mp-weixin",
    "miniapp:build": "pnpm --filter uni-preset-vue build:mp-weixin"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.8",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "mermaid": "^11.16.1",
    "puppeteer": "^25.8.0",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-mermaid-renderer": "^1.2.0",
    "vue": "^3.5.41"
  }
}
