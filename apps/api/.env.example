APP_NAME=Pocket Farm API
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+aiomysql://root:wj123456@127.0.0.1:3306/pocket_farm?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
APP_TIMEZONE=Asia/Shanghai
TEST_LOGIN_ENABLED=true
TEST_LOGIN_CODE=8888

# AI Tab (DeepSeek). Keep real secrets only in apps/api/.env or deployment
# secret storage. The API remains runnable without these two secret values;
# the future AI endpoint will reject calls until they are configured.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_REQUEST_TIMEOUT_SECONDS=30
AI_DAILY_TURN_LIMIT=20
AI_MAX_MESSAGE_CHARS=1000
AI_MAX_HISTORY_TURNS=8
AI_MAX_TOOL_CALLS_PER_TURN=6
AI_MAX_OUTPUT_TOKENS=800
AI_NOTICE_VERSION=v1
AI_USER_ID_HASH_KEY=
